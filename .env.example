# BitCraft Claim Monitor environment example
# Copy the variables you need into a local .env file or the protected VPS file
# /etc/bitcraft-claim-monitor.env. Do not commit real secrets.

# Local development
PORT=18428
LOCAL_API_PORT=18430
BITCRAFT_LOCAL_DATA_DIR=apps/bitcraft-local/data

# Production server
APP_HOST=127.0.0.1
APP_PORT=18430
NODE_ENV=production
# BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor

# BitJita upstream behavior
BITJITA_API_ORIGIN=https://bitjita.com
BITJITA_APP_IDENTIFIER="BitCraft Claim Monitor (github.com/Red463/bitcraft-claim-monitor)"
# BITJITA_FETCH_TIMEOUT_MS=15000
# BITJITA_PROXY_TIMEOUT_MS=12000
# BITJITA_PROXY_CACHE_MS=15000
# BITJITA_PROXY_STALE_IF_ERROR_MS=300000
# BITJITA_PROXY_CACHE_MAX_ENTRIES=300

# Admin and authentication
DEFAULT_OWNER_DISCORD_ID=145544610234630144
# ADMIN_SETUP_KEY=replace-with-long-random-setup-key
# ENABLE_LEGACY_ADMIN_PASSWORD_AUTH=false
# DISCORD_OAUTH_CLIENT_ID=replace-with-discord-application-id
# DISCORD_OAUTH_CLIENT_SECRET=replace-with-discord-oauth-client-secret
# DISCORD_OAUTH_REDIRECT_URI=https://your-domain.example/api/local/auth/discord/callback

# Optional Discord bot overrides. Prefer Admin > Discord for non-secret IDs.
# DISCORD_BOT_TOKEN=replace-with-discord-bot-token
# DISCORD_APPLICATION_ID=replace-with-discord-application-id
# DISCORD_PUBLIC_KEY=replace-with-discord-public-key
# DISCORD_GUILD_ID=replace-with-discord-server-id
# DISCORD_CHANNEL_ID=replace-with-default-notification-channel-id

# Optional background task controls
# ENABLE_SERVER_POLLING=true
# ENABLE_DISCORD_STARTUP=true
# ENABLE_SCHEDULED_JOBS=true
# SNAPSHOT_INTERVAL_MS=30000
# PRODUCTION_MISSING_GRACE_MS=120000

# Optional visitor security / GeoIP configuration
# GEOIP_DATA_PATH=/var/lib/bitcraft-claim-monitor/geoip/geoip.json
# IPAPI_BASE_URL=https://ipapi.co
