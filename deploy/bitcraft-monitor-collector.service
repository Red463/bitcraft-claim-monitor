[Unit]
Description=BitCraft Claim Monitor host telemetry collector
After=network-online.target

[Service]
Type=oneshot
User=root
Group=bitcraft
Environment=BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor
ExecStart=/usr/bin/node /opt/bitcraft-claim-monitor/current/deploy/collect-server-health.mjs
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitcraft-claim-monitor/monitoring
