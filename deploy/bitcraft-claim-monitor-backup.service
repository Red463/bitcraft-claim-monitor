[Unit]
Description=Create the daily BitCraft Claim Monitor database backup
After=network-online.target

[Service]
Type=oneshot
User=root
Environment=BACKUP_ENCRYPTION_KEY_FILE=/etc/bitcraft-claim-monitor/backup-encryption.key
Environment=BACKUP_CRYPTO_HELPER=/usr/local/lib/bitcraft-claim-monitor/backup-crypto.mjs
ExecStart=/bin/bash /usr/local/bin/backup-bitcraft-monitor daily
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
