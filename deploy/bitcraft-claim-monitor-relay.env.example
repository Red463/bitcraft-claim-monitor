# Relay preview process configuration.
# Install as /etc/bitcraft-claim-monitor-relay.env with mode 0600.

NODE_ENV=production
APP_HOST=127.0.0.1
APP_PORT=19430
BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor-relay
BITCRAFT_RELAY_ORIGIN=https://relay.bitcraftsync.app
ENABLE_RELAY_PROVIDER=true
RELAY_HTTP_REFRESH_MS=15000

# Preview is shadow-only by default. Changing this to live is a cutover action.
DISCORD_DELIVERY_MODE=record
ENABLE_DISCORD_STARTUP=false

# A later manual-delivery implementation may send only to this sandbox channel.
# It must never default to the production notification channel.
DISCORD_SANDBOX_CHANNEL_ID=

# Configure secrets only in the installed environment file.
ADMIN_SETUP_KEY=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
LEGAL_CONFIGURATION_CONFIRMED=false
