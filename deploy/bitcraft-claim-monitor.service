[Unit]
Description=BitCraft Claim Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bitcraft
Group=bitcraft
WorkingDirectory=/opt/bitcraft-claim-monitor/current/apps/bitcraft-local
Environment=NODE_ENV=production
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=18430
Environment=BITCRAFT_LOCAL_DATA_DIR=/var/lib/bitcraft-claim-monitor
Environment=BITCRAFT_PROCESS_ROLE=web
Environment=PRIVACY_LEDGER_PATH=/var/backups/bitcraft-claim-monitor/privacy-deletion-ledger.jsonl
Environment=PRIVACY_LEDGER_KEY_FILE=/etc/bitcraft-claim-monitor/privacy-ledger.key
Environment=MALLOC_TRIM_THRESHOLD_=131072
EnvironmentFile=-/etc/bitcraft-claim-monitor.env
ExecStart=/usr/bin/node /opt/bitcraft-claim-monitor/current/apps/bitcraft-local/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bitcraft-claim-monitor /var/backups/bitcraft-claim-monitor

[Install]
WantedBy=multi-user.target
